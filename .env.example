# Default graded mode. Everything in this repo must pass with MOCK_LLM=1.
MOCK_LLM=1

# CrewAI ships telemetry that makes an outbound call on kickoff(). Keep it off.
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true

# Optional only. Never required by any acceptance criterion.
# OPENAI_API_KEY=
# REAL_LLM_MODEL=gpt-4o-mini
